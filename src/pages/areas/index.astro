---
import Layout from '../../layouts/Layout.astro';
import { listPapers } from '../../lib/papers';
import { areasByGroup, taxonomy } from '../../lib/taxonomy';
import { url } from '../../lib/url';

const groups = areasByGroup();
const papers = await listPapers();

// Group papers by area
const papersByArea: Record<string, any[]> = {};
papers.forEach(paper => {
  if (!papersByArea[paper.data.area]) {
    papersByArea[paper.data.area] = [];
  }
  papersByArea[paper.data.area].push(paper);
});

const areaCount = Object.keys(taxonomy.areas).length;
---

<Layout
    title="Areas | Awesome Agentic Systems"
    description={`The ${areaCount} areas a paper can be filed under, grouped into ${groups.length} layers. One area per paper: the one its contribution belongs to.`}
>
    <div class="page-header">
        <h2>Areas Overview</h2>
        <p class="subtitle">
            {papers.length} papers across {areaCount} areas, grouped into {groups.length} layers.
            A paper belongs to exactly one area; the scale of the system is carried by the <code>scale</code> facet.
        </p>
    </div>

    {groups.map(({ group, areas }) => (
        <section class="group">
            <div class="group-header">
                <h3>{group.label}</h3>
                <p>{group.blurb}</p>
            </div>
            <div class="areas-grid">
                {areas.map(({ key, area }) => {
                    const count = papersByArea[key]?.length || 0;
                    return (
                        <a href={url(`/areas/${key}`)} class:list={["area-card", { empty: count === 0 }]}>
                            <h4>{area.label}</h4>
                            <p>{area.blurb}</p>
                            <div class="stats">
                                <span class="count">{count} papers</span>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    ))}
</Layout>

<style>
    .page-header {
        margin-bottom: 40px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .page-header h2 {
        font-size: 2rem;
        margin-bottom: 8px;
    }

    .subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin: 0;
    }

    .subtitle code {
        background: var(--muted-tint);
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .group {
        margin-bottom: 48px;
    }

    .group-header {
        margin-bottom: 20px;
    }

    .group-header h3 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 4px;
    }

    .group-header p {
        color: var(--text-main);
        font-size: 1.05rem;
        margin: 0;
    }

    .areas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .area-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 24px;
        transition: transform 0.2s, border-color 0.2s;
        display: flex;
        flex-direction: column;
        text-decoration: none;
    }

    .area-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-color);
        text-decoration: none;
    }

    /* An empty area is not an error: it is a visible gap in the map. */
    .area-card.empty {
        border-style: dashed;
        opacity: 0.6;
    }

    .area-card h4 {
        font-size: 1.2rem;
        margin-bottom: 8px;
        color: var(--accent-color);
    }

    .area-card p {
        color: var(--text-muted);
        font-size: 0.9rem;
        flex-grow: 1;
        margin-bottom: 16px;
    }

    .stats {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border-color);
        padding-top: 12px;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .count {
        background: var(--accent-tint);
        color: var(--accent-color);
        padding: 2px 8px;
        border-radius: 12px;
        font-weight: 500;
    }
</style>
