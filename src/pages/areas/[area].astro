---
import Layout from '../../layouts/Layout.astro';
import { listPapers, formatAuthors } from '../../lib/papers';
import { listResources, formatBy } from '../../lib/resources';
import { taxonomy } from '../../lib/taxonomy';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const papers = await listPapers();
  const resources = await listResources();

  return Object.entries(taxonomy.areas).map(([areaKey, area]) => ({
    params: { area: areaKey },
    props: {
      areaData: area,
      group: taxonomy.groups[area.group],
      papers: papers.filter(p => p.data.area === areaKey),
      resources: resources.filter(r => r.data.area === areaKey)
    }
  }));
}

const { areaData, group, papers, resources } = Astro.props;

// Surveys are the way into an area: they go on top, separated out.
const surveys = papers.filter((p: any) => p.data.type.includes('survey'));
const rest = papers.filter((p: any) => !p.data.type.includes('survey'));
rest.sort((a: any, b: any) => (b.data.year || 0) - (a.data.year || 0));
---

<Layout
  title={`${areaData.label} | Awesome Agentic Systems`}
  description={`${areaData.blurb} ${papers.length} papers.`}
>
  <div class="breadcrumb">
    <a href={url('/areas')}>← All areas</a>
    <span class="crumb-sep">/</span>
    <span class="crumb-group">{group.label}</span>
  </div>

  <div class="area-header">
    <h2>{areaData.label}</h2>
    <p>{areaData.blurb}</p>
    <div class="meta">
      <span>{papers.length} papers</span>
    </div>
  </div>

  {surveys.length > 0 && (
    <section class="entry-point">
      <h3>Where to start</h3>
      <p class="entry-desc">Surveys and taxonomies for this area.</p>
      <div class="paper-list">
        {surveys.map((paper: any) => (
          <a href={url(`/papers/${paper.data.id}`)} class="paper-card survey">
            <div class="paper-title">
              <span class="badge survey-badge">survey</span>
              {paper.data.title}
            </div>
            <div class="paper-authors" data-authors={JSON.stringify(paper.data.authors)} data-suffix={` (${paper.data.year})`}>{formatAuthors(paper.data.authors)} ({paper.data.year})</div>
            {paper.data.tldr && <p class="paper-tldr">{paper.data.tldr}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="paper-list">
    {rest.map((paper: any) => (
      <a href={url(`/papers/${paper.data.id}`)} class="paper-card">
        <div class="paper-title">
          {paper.data.title}
        </div>
        <div class="paper-authors" data-authors={JSON.stringify(paper.data.authors)} data-suffix={` (${paper.data.year})`}>{formatAuthors(paper.data.authors)} ({paper.data.year})</div>
        <div class="paper-topics">
          {paper.data.topics.map((t: string) => (
            <span class="topic-tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
    {papers.length === 0 && (
      <div class="empty-state">
        No papers in this area yet. The gap is deliberate: the area exists in
        the taxonomy even before anything lives in it.
      </div>
    )}
  </div>

  {resources.length > 0 && (
    <section class="related-resources">
      <h3>Related resources</h3>
      <p class="entry-desc">
        Protocols, books, courses and software tagged with this area.
        See <a href={url('/resources')}>all resources</a>.
      </p>
      <ul>
        {resources.map((r: any) => (
          <li>
            <a href={r.data.url} target="_blank" rel="noopener">{r.data.title}</a>
            {formatBy(r) && <span class="resource-by"> · {formatBy(r)}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .related-resources {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .related-resources h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .related-resources ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .resource-by {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .breadcrumb {
    margin-bottom: 24px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent-color);
  }

  .crumb-sep {
    margin: 0 8px;
    opacity: 0.5;
  }

  .area-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
  }

  .area-header h2 {
    font-size: 2rem;
    color: var(--text-main);
  }

  .area-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 800px;
  }

  .meta {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--accent-color);
    font-weight: 500;
  }

  .entry-point {
    margin-bottom: 40px;
  }

  .entry-point h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .entry-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  .paper-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .paper-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 20px;
    border-radius: 8px;
    transition: border-color 0.2s;
    text-decoration: none;
    display: block;
  }

  .paper-card:hover {
    border-color: var(--accent-color);
    text-decoration: none;
  }

  .paper-card.survey {
    border-left: 3px solid var(--accent-color);
  }

  .paper-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8px;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    vertical-align: middle;
    margin-right: 8px;
  }

  .survey-badge {
    background: var(--accent-tint-strong);
    color: var(--accent-color);
  }

  .paper-authors {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .paper-tldr {
    color: var(--text-main);
    font-size: 0.95rem;
    margin: 0;
  }

  .paper-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-tag {
    background: var(--muted-tint);
    color: var(--text-muted);
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.8rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    padding: 40px 0;
    max-width: 600px;
  }
</style>
